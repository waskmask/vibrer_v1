    <script>
      // Function to check if user has scrolled to the bottom
      function isScrolledToBottom() {
        return (
          window.innerHeight + window.scrollY >= document.body.offsetHeight
        );
      }

      // Variables to track pagination and loading state
      let page = 0;
      let isLoading = false;
      let allDataLoaded = false; // Flag to indicate if all data has been loaded

      // Function to show loader
      function showLoader() {
        document.getElementById("loadingIndicator").style.display = "block";
      }

      // Function to hide loader
      function hideLoader() {
        document.getElementById("loadingIndicator").style.display = "none";
      }

      // Function to load more content
      async function loadMoreContent() {
        // Check if a request is already in progress or all data has been loaded
        if (isLoading || allDataLoaded) return;

        // Set isLoading to true to indicate that a request is in progress
        isLoading = true;
        // Show loader
        showLoader();

        // Increment the page number for pagination
        page += 1;

        try {
          const localToken = localStorage.getItem("appUserToken");
          if (localToken) {
            const response = await fetch(
              `<%- API_URL %>auth/contest-entries/<%- contest_id %>`,
              {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  Authorization: `Bearer ${localStorage.getItem(
                    "appUserToken"
                  )}`,
                },
                body: JSON.stringify({
                  limit: 10,
                  offset: page,
                  is_top_three_participants: false,
                }),
              }
            );

            // Parse the JSON response
            const responseData = await response.json();

            // Check if the response status is successful
            if (responseData.status === 1) {
              const participantData = responseData.result.participates;

              // Check if the participantData array is empty
              if (participantData.length === 0) {
                allDataLoaded = true; // Set flag to true if no more data
              } else {
                // Render the participant data
                renderParticipantData(participantData, "restEntriesContainer");
              }
            }
          }
        } catch (error) {
          console.error("Error fetching data:", error);
        } finally {
          // Set isLoading to false to indicate that the request is complete
          isLoading = false;

          // Hide loader
          hideLoader();
        }
      }

      // Event listener for scroll event
      window.addEventListener("scroll", () => {
        // Check if scrolled to the bottom, no request is in progress, and not all data is loaded
        if (isScrolledToBottom() && !isLoading && !allDataLoaded) {
          loadMoreContent();
        }
      });
    </script>
