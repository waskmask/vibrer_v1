<!DOCTYPE html>
<html lang="en">
  <head>
    <meta name="theme-color" content="#1e2750" />

    <meta
      name="description"
      content="Join Vibrer's prelaunch and be the first to experience a revolutionary music platform. Connect, discover, and engage with artists and music enthusiasts worldwide."
    />
    <meta
      name="keywords"
      content="music platform, music community, music discovery, artist connection, music enthusiasts"
    />
    <%- include('../partials/head'); %>
    <link href="/public/style/quill.snow.css?v=3.1" rel="stylesheet" />
    <link rel="stylesheet" href="/public/style/table.css?v=3.1" />
    <link rel="stylesheet" href="/public/style/app.css?v=3.1" />
    <link href="/public/style/video-js.css?v=3.1" rel="stylesheet" />
  </head>
  <body class="body-dark _pr">
    <!-- loader -->
    <%- include('../partials/loader'); %>

    <!-- header -->
    <%- include('./partials/pre-header'); %>

    <main class="app_layout app_wrapper">
      <!-- <%- include('components/app-sidebar'); %> -->

      <!-- main body of the app -->
      <div class="app_main app_main_large">
        <div class="title mb-3">
          Reports <% if(reportsData.length > 0){ %> (<%- reportsData.length %>)
          <% } %>
        </div>
        <div class="app_page_menu">
          <div
            onclick="toReports('<%= path  %>', '<%= link %>');"
            class="<%= (link == 'allreports') ? 'active page_menu_link' : 'page_menu_link' %>"
          >
            All reports
          </div>
          <div
            onclick="toActiveReports('<%= path  %>', '<%= link %>');"
            class="<%= (link == 'active') ? 'active page_menu_link' : 'page_menu_link' %>"
          >
            Active
          </div>
          <div
            onclick="youReported('<%= path  %>', '<%= link %>');"
            class="<%= (link == 'youreported') ? 'active page_menu_link' : 'page_menu_link' %>"
          >
            You reported
          </div>
        </div>
        <div class="table-wrapper">
          <table class="table table-light">
            <thead>
              <tr>
                <th>Reported on</th>
                <th>Reason</th>
                <th>Status</th>
                <th><div class="flex-end">Action</div></th>
              </tr>
            </thead>
            <tbody>
              <% if (reportsData.length > 0) { reportsData.forEach(reports => {
              let createdAt = new Date(reports.createdAt); let date =
              createdAt.toLocaleDateString('en-GB'); // format as dd/MM/yyyy let
              time = createdAt.toLocaleTimeString('en-GB', { hour: '2-digit',
              minute: '2-digit' }); // format as HH:mm %>
              <tr>
                <td>
                  <%= date.replace(/\//g, '.') %> <br />
                  <small><%= time.replace(':', '.') %></small>
                </td>
                <td class="max80"><%- reports.report_reason %></td>
                <td>
                  <% if(reports.status === 'Pending'){ %>
                  <div class="status open">Pending</div>
                  <% } else if(reports.status === 'Open'){ %>
                  <div class="status open">Open</div>
                  <% } else if(reports.status === 'Under process'){ %>
                  <div class="status processing">Under process</div>
                  <% } else if(reports.status === 'Closed'){ %>
                  <div class="status closed">Closed</div>
                  <% } %>
                </td>
                <td>
                  <div class="flex-end">
                    <button class="btn btn-primary btn-xs">View</button>
                  </div>
                </td>
              </tr>
              <% }); } %>

              <!-- <tr>
                <td>
                  03.08.2023 <br />
                  <small>12.09</small>
                </td>
                <td>Copyright content</td>
                <td>
                  <div class="status closed">Closed</div>
                </td>
                <td>
                  <div class="flex-end">
                    <button class="btn btn-primary btn-xs">View</button>
                  </div>
                </td>
              </tr>
              <tr>
                <td>
                  03.08.2023 <br />
                  <small>12.09</small>
                </td>
                <td>Copyright content</td>
                <td>
                  <div class="status processing">Under process</div>
                </td>
                <td>
                  <div class="flex-end">
                    <button class="btn btn-primary btn-xs">View</button>
                  </div>
                </td>
              </tr> -->
            </tbody>
          </table>
        </div>
        <!-- app main end -->
      </div>
    </main>

    <!-- javascript -->
    <script src="/public/js/redirections.js?v=3.1"></script>
    <script src="/public/js/general.js?v=3.1"></script>
    <script src="/public/js/app_language.js?v=3.1"></script>
    <script src="/public/js/quill.min.js?v=3.1"></script>
    <script src="/public/js/video.min.js?v=3.1"></script>
    <script src="/public/js/sweetalert2@11.js?v=3.1"></script>
    <script src="/public/js/_modal.js?v=3.1"></script>
    <script src="/public/js/check-select.js?v=3.1"></script>
    <script src="/public/js/config.js?v=3.1"></script>
  </body>
</html>
