      const getOrdinalSuffix = (number) => {
        const suffixes = ["th", "st", "nd", "rd"];
        const v = number % 100;
        return suffixes[(v - 20) % 10] || suffixes[v] || suffixes[0];
      };

      // Function to render participant data
      function renderParticipantData(data, containerId) {
        const container = document.getElementById(containerId);
        const wrapperDiv = document.createElement("div");
        wrapperDiv.classList.add("wrapper-lg-4");
        let alreadyVoted = "";
        data.forEach((participant) => {
          if (participant.is_voted) {
            alreadyVoted = participant.user._id;
          }
          let participantRank = getOrdinalSuffix("" + participant.rank + "");
          const contestantDiv = document.createElement("div");
          contestantDiv.classList.add("contestant", "mb-3");
          // Render participant details here...
          const reportDd = document.createElement("div");
          reportDd.classList.add("report_dd");
          const reportIcon = document.createElement("img");
          reportIcon.src = "/public/images/icons/info_icon.svg";
          reportIcon.alt = "Report";
          reportIcon.classList.add("reportIcon");
          const dropDown = document.createElement("div");
          dropDown.classList.add("drop_down", "shadow");
          const reportLink = document.createElement("div");
          reportLink.classList.add("report_link");
          reportLink.addEventListener("click", function () {
            resdirectAfterLogin(
              `/app/contest-report/<%=contestDetailData.result._id%>/${participant._id}`
            );
          });
          reportLink.textContent = '<%= __("report") %>';
          dropDown.appendChild(reportLink);
          reportDd.appendChild(reportIcon);
          reportDd.appendChild(dropDown);
          const headDiv = document.createElement("div");
          headDiv.classList.add("head");

          const youVotedDiv = document.createElement("div");
          youVotedDiv.classList.add(
            "yourVote<%- contestDetailData.result._id %>"
          );
          youVotedDiv.id = `yourVote<%- contestDetailData.result._id %>${participant.user._id}`;

          headDiv.appendChild(youVotedDiv);

          if (participant.is_voted) {
            alreadyVoted = participant.user._id;

            const youVotedMessageDiv = document.createElement("div");
            youVotedMessageDiv.classList.add("yourVote");
            youVotedMessageDiv.textContent = `<%= __('you_voted') %>`;

            youVotedDiv.appendChild(youVotedMessageDiv);
          }

          //Render video element
          const videoElement = document.createElement("video");
          videoElement.controls = true;
          videoElement.classList.add("video-js");
          videoElement.preload = "none";
          videoElement.width = "640";
          videoElement.height = "264";
          videoElement.poster =
            participant.user.profile_img || "/public/images/default-avatar.png";
          videoElement.dataset.setup = "{}";
          const sourceElement = document.createElement("source");
          sourceElement.src = participant.media;
          sourceElement.type = "video/mp4";
          videoElement.appendChild(sourceElement);
          const hiddenInput = document.createElement("input");
